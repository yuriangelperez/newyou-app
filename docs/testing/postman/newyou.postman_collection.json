    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login vendedor (TC-HU02-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('devuelve access_token (JWT)', () => pm.expect(j.access_token.split('.')).to.have.length(3));",
                  "pm.collectionVariables.set('tokenVendedor', j.access_token);",
                  "pm.collectionVariables.set('uidVendedor', j.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{vendedorEmail}}\",\n  \"password\": \"{{vendedorPassword}}\"\n}"
            }
          }
        },
