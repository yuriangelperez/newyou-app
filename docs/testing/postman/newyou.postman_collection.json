    {
      "name": "2. CRUD secuencial de productos",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json()[0];",
                  "pm.test('queda a nombre del vendedor', () => pm.expect(p.creado_por).to.eql(pm.collectionVariables.get('uidVendedor')));",
                  "pm.collectionVariables.set('productoId', p.productoid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenVendedor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/productos"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prenda de prueba Postman\",\n  \"descripcion\": \"Creada por la colección de pruebas\",\n  \"precio\": 15000,\n  \"descuento_porcentaje\": 0,\n  \"stock\": 3,\n  \"categoriaid\": 1,\n  \"imagen_url\": \"\",\n  \"imagenes\": [],\n  \"talles\": [\n    \"M\"\n  ],\n  \"colores\": [\n    \"Negro\"\n  ],\n  \"tipo_prenda\": \"Camisas\",\n  \"temporada\": \"Todo el año\",\n  \"publico\": \"Adulto\",\n  \"creado_por\": \"{{uidVendedor}}\",\n  \"direccion_retiro\": \"Pilar, Buenos Aires\"\n}"
            }
          }
        },
        {
          "name": "Leer producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y un resultado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.length(1); });",
                  "pm.test('precio original', () => pm.expect(Number(pm.response.json()[0].precio)).to.eql(15000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/productos?productoid=eq.{{productoId}}&select=productoid,nombre,precio,stock"
            }
          }
        },
        {
          "name": "Actualizar precio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y precio nuevo', () => { pm.response.to.have.status(200); pm.expect(Number(pm.response.json()[0].precio)).to.eql(12000); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenVendedor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/productos?productoid=eq.{{productoId}}"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 12000\n}"
            }
          }
        },
        {
          "name": "Borrar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
