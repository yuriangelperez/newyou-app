                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/compras"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": \"{{uidComprador}}\",\n  \"total\": 1,\n  \"items\": []\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Concurrencia e idempotencia del checkout (TC-HU14-02)",
      "description": "Correr en el Runner con 10 iteraciones y delay 0. Todas las iteraciones usan la misma operation_key: tiene que existir una sola compra. Requiere `productoCompraId` con stock en el environment.",
      "item": [
        {
          "name": "Confirmar compra con la misma operation_key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('operationKey')) {",
                  "  pm.collectionVariables.set('operationKey', 'postman-' + Date.now());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const compra = pm.response.json();",
                  "const primera = pm.collectionVariables.get('primeraCompraId');",
                  "if (!primera) { pm.collectionVariables.set('primeraCompraId', compra.compraid); }",
                  "pm.test('siempre devuelve la misma compra', () => pm.expect(compra.compraid).to.eql(Number(primera || compra.compraid)));",
                  "pm.test('el total lo calcula el servidor, no el precio enviado', () => pm.expect(Number(compra.total)).to.be.above(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenComprador}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/rpc/confirmar_compra"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_operation_key\": \"{{operationKey}}\",\n  \"p_entrega\": \"local\",\n  \"p_metodo_pago\": \"Efectivo\",\n  \"p_envio\": 0,\n  \"p_direccion_entrega\": null,\n  \"p_items\": [\n    {\n      \"productoId\": \"{{productoCompraId}}\",\n      \"nombre\": \"Prenda\",\n      \"precio\": 1,\n      \"cantidad\": 1,\n      \"talle\": \"M\",\n      \"color\": \"Negro\"\n    }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Performance",
      "item": [
        {
          "name": "Catálogo en menos de 1,5 s (RNF, TC-HU03-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('responde en menos de 1500 ms', () => pm.expect(pm.response.responseTime).to.be.below(1500));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/productos?select=productoid,nombre,precio,stock,imagen_url&order=productoid.desc&limit=50"
            }
          }
        }
      ]
    }
  ]
