digraph G {
graph [fontname="DejaVu Sans", fontsize=13, rankdir=TB, nodesep=0.35, ranksep=0.32, bgcolor="white", pad=0.3, labelloc=t, labeljust=c];
node [fontname="DejaVu Sans", fontsize=11, style="filled", color="#5B6770", penwidth=1.2, margin="0.15,0.07"];
edge [fontname="DejaVu Sans", fontsize=10, color="#5B6770", arrowsize=0.7, fontcolor="#333333"];
label=<<b>A. Confirmar compra</b>>;
ini [label="Inicio: el comprador abre el checkout", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
key [label="Generar operationKey (una sola vez)", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
datos [label="Entrega, dirección\ny medio de pago", shape=parallelogram, fillcolor="#E6EEF8", color="#3B6EA5", margin="0.02,0.04"];
vacio [label="¿Carrito\ncon prendas?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
e1 [label="Aviso: el carrito está vacío", shape=box, style="rounded,filled", fillcolor="#FDE8E6", color="#C0392B"];
f1 [label="Fin", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
dir [label="¿Hay dirección de\nentrega o retiro?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
e2 [label="Aviso: ingresá tu dirección", shape=box, style="rounded,filled", fillcolor="#FDE8E6", color="#C0392B"];
f2 [label="Fin", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
btn [label="Deshabilitar el botón", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
red [label="¿Hay conexión?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
draft [label="Guardar borrador en ny_drafts", shape=cylinder, fillcolor="#EEE8F6", color="#6C4F9C"];
vac1 [label="Vaciar carrito y avisar\n\"Guardado en borradores\"", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
f3 [label="Fin", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
rpc [label="Llamar a confirmar_compra", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
subgraph cluster_srv { label="Servidor (Supabase, una sola transacción)"; style="rounded,dashed"; color="#6C4F9C"; fontcolor="#6C4F9C"; fontsize=12;
ses [label="¿Hay sesión?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
prev [label="¿Ya existe una compra\ncon esa operation_key?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
dev [label="Devolver la compra existente\n(idempotencia)", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
lock [label="Por cada prenda: bloquear\nla fila (FOR UPDATE)", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
stock [label="¿Alcanza el stock\n(publicación o sede)?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
rech [label="Rechazar toda la compra\n(no se descuenta nada)", shape=box, style="rounded,filled", fillcolor="#FDE8E6", color="#C0392B"];
desc [label="Descontar stock y\naplicar descuento", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
crear [label="Crear compra, pedidos por\nvendedor o sede y evento\n\"pendiente\"", shape=cylinder, fillcolor="#EEE8F6", color="#6C4F9C"];
}
ok [label="¿El servidor\nrespondió bien?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
vac2 [label="Vaciar carrito y mostrar\n\"Compra confirmada, Orden #N\"", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
e3 [label="Mostrar el error y habilitar el botón\n(el reintento usa la misma operationKey)", shape=box, style="rounded,filled", fillcolor="#FDE8E6", color="#C0392B"];
fin [label="Fin", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
f4 [label="Fin", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
ini -> key;
key -> datos;
datos -> vacio;
vacio -> e1 [label=" No "];
e1 -> f1;
vacio -> dir [label=" Sí "];
dir -> e2 [label=" No "];
e2 -> f2;
dir -> btn [label=" Sí "];
btn -> red;
red -> draft [label=" No "];
draft -> vac1;
vac1 -> f3;
red -> rpc [label=" Sí "];
rpc -> ses;
ses -> rech [label=" No "];
ses -> prev [label=" Sí "];
prev -> dev [label=" Sí "];
prev -> lock [label=" No "];
lock -> stock;
stock -> rech [label=" No "];
stock -> desc [label=" Sí "];
desc -> crear;
crear -> ok;
dev -> ok;
rech -> ok;
ok -> vac2 [label=" Sí "];
ok -> e3 [label=" No "];
vac2 -> fin;
e3 -> f4;
}
