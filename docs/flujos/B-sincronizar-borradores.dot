digraph G {
graph [fontname="DejaVu Sans", fontsize=13, rankdir=TB, nodesep=0.35, ranksep=0.32, bgcolor="white", pad=0.3, labelloc=t, labeljust=c];
node [fontname="DejaVu Sans", fontsize=11, style="filled", color="#5B6770", penwidth=1.2, margin="0.15,0.07"];
edge [fontname="DejaVu Sans", fontsize=10, color="#5B6770", arrowsize=0.7, fontcolor="#333333"];
label=<<b>B. Sincronizar borradores</b>>;
ini [label="Inicio: vuelve la conexión\ny hay sesión activa", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
ya [label="¿Ya se está\nsincronizando?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
leer [label="Leer la cola ny_drafts", shape=cylinder, fillcolor="#EEE8F6", color="#6C4F9C"];
hay [label="¿Quedan borradores\npor procesar?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
tipo [label="¿El borrador es\nuna compra?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
compra [label="confirmar_compra con su\noperationKey (no se duplica)", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
prod [label="Crear la prenda", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
ok [label="¿Se subió bien?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
cuenta [label="Sumar 1 a sincronizados", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
rest [label="Dejarlo en la cola\npara la próxima reconexión", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
sig [label="Pasar al siguiente borrador", shape=box, style="rounded,filled", fillcolor="#EAF2EE"];
f0 [label="Fin", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
guardar [label="Guardar en ny_drafts\nlos que quedaron", shape=cylinder, fillcolor="#EEE8F6", color="#6C4F9C"];
alguno [label="¿Se sincronizó\nalguno?", shape=diamond, fillcolor="#FFF4D6", color="#B58900", margin="0.03,0.02"];
aviso [label="Avisar cuántas\nse subieron", shape=parallelogram, fillcolor="#E6EEF8", color="#3B6EA5", margin="0.02,0.04"];
fin [label="Fin", shape=ellipse, fillcolor="#2E5E4E", fontcolor="white", color="#2E5E4E"];
ini -> ya;
ya -> f0 [label=" Sí "];
ya -> leer [label=" No "];
leer -> hay;
hay -> tipo [label=" Sí "];
tipo -> compra [label=" Sí "];
tipo -> prod [label=" No "];
compra -> ok;
prod -> ok;
ok -> cuenta [label=" Sí "];
ok -> rest [label=" No "];
cuenta -> sig;
rest -> sig;
c1 [label="1", shape=circle, fillcolor="#FFFFFF", color="#2E5E4E", fontcolor="#2E5E4E", width=0.35, fixedsize=true];
c1b [label="1", shape=circle, fillcolor="#FFFFFF", color="#2E5E4E", fontcolor="#2E5E4E", width=0.35, fixedsize=true];
sig -> c1;
c1b -> hay;
hay -> guardar [label=" No "];
guardar -> alguno;
alguno -> aviso [label=" Sí "];
alguno -> fin [label=" No "];
aviso -> fin;
}
