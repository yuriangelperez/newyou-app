{
  "expo": {
    "name": "newyou-app",
    "slug": "newyou-app",
    "scheme": "newyou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/app-icons/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F4",
        "foregroundImage": "./assets/app-icons/android-icon-foreground.png",
        "monochromeImage": "./assets/app-icons/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.newyouapp"
    },
    "web": {
      "favicon": "./assets/app-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que NewYou acceda a tus fotos para publicar prendas.",
          "cameraPermission": "Permite que NewYou use la cámara para fotografiar tus prendas.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que NewYou use tu ubicación para completar la dirección de tu tienda."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icons/android-icon-monochrome.png",
          "color": "#F4F4F4"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icons/splash-icon.png",
          "backgroundColor": "#F4F4F4",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1bf8b99-89e4-4dff-90aa-f1679c492a07"
      }
    }
  }
}
